# ============================================
# FRSHTALK BACKEND - ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (FREE TIER)
# Get these from: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# Razorpay Configuration (FREE - Pay per transaction only)
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Twilio Configuration (OTP SMS)
# Get these from: https://console.twilio.com/
# Cost: $0.0075 per SMS (only charged when used)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# WebRTC Configuration
# Free STUN servers
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302

# TURN Server (Optional for better connectivity)
# Free tier: https://www.metered.ca/tools/openrelay/ (~$5-10/month for better service)
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# App Configuration
SIGNUP_BONUS_COINS=100
VOICE_CALL_RATE=1
VIDEO_CALL_RATE=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cors Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# ============================================
# DEPLOYMENT NOTES (FREE TIER)
# ============================================

# Railway (Recommended - FREE)
# - 500 MB RAM, $5 free credit monthly
# - Deploy: railway up
# - Auto-deploy from GitHub

# Vercel (Alternative - FREE)
# - Serverless functions
# - Deploy: vercel
# - Good for API routes

# Render (Alternative - FREE)
# - 512 MB RAM, free tier
# - Deploy: git push
# - Spins down after 15min inactivity

# ============================================
# COST BREAKDOWN
# ============================================
# Supabase: FREE (500MB DB, unlimited API)
# Railway: FREE ($5 credit monthly)
# Razorpay: 2% per transaction only
# Twilio OTP: $0.0075 per SMS
# TURN Server: ~$5-10/month (optional)
#
# TOTAL: $0-15/month depending on usage
# ============================================
